<Window x:Class="MultiChatManager2.YoudaoLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录有道智云"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>

        <Style x:Key="TopButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="MinWidth"
                    Value="100"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="Margin"
                    Value="8,0,0,0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#111827"/>

            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F3F4F6"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TopButtonStyle}">

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#2563EB"/>

        </Style>

    </Window.Resources>

    <Grid Margin="18">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="12"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- 顶部状态栏 -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="有道智云账号登录"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock x:Name="LoginStatusTextBlock"
                               Text="正在打开有道智云登录页面..."
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="#6B7280"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="ReloadButton"
                            Content="↻ 重新加载"
                            Style="{StaticResource TopButtonStyle}"
                            Click="ReloadButton_Click"/>

                    <Button x:Name="OpenConsoleButton"
                            Content="打开控制台"
                            Style="{StaticResource TopButtonStyle}"
                            Click="OpenConsoleButton_Click"/>

                    <Button x:Name="LoginCompletedButton"
                            Content="✓ 登录完成"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="LoginCompletedButton_Click"/>

                    <Button x:Name="CancelButton"
                            Content="取消"
                            Style="{StaticResource TopButtonStyle}"
                            Click="CancelButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- WebView2 -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">

            <Grid>

                <wv2:WebView2 x:Name="YoudaoWebView"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>

                <Border x:Name="LoadingBorder"
                        Background="#CCFFFFFF"
                        Visibility="Visible">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="正在加载有道智云..."
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="首次打开可能需要几秒钟"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>