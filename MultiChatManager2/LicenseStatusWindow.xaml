<Window x:Class="MultiChatManager2.LicenseStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="激活状态"
        Width="620"
        Height="690"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>

        <Style x:Key="InfoTitleStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Foreground"
                    Value="#6B7280"/>
            <Setter Property="Margin"
                    Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InfoValueStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#111827"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
        </Style>

        <Style x:Key="InfoCardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#F9FAFB"/>
            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="10"/>
            <Setter Property="Padding"
                    Value="16"/>
            <Setter Property="Margin"
                    Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CloseButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="120"/>
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="Background"
                    Value="#2563EB"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E40AF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">

        <Border Background="White"
                CornerRadius="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="28">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center">

                    <TextBlock Text="🔑"
                               FontSize="34"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="授权状态"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="RefreshStatusTextBlock"
                               Text="正在读取授权信息..."
                               FontSize="12"
                               Foreground="#9CA3AF"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- 状态区域 -->
                <Border Grid.Row="1"
                        x:Name="StatusBorder"
                        Background="#ECFDF5"
                        BorderBrush="#A7F3D0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,24,0,18">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <TextBlock x:Name="StatusIconTextBlock"
                                   Text="🟢"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBlock x:Name="StatusTextBlock"
                                   Text="正在检查"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#047857"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <!-- 信息内容 -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <Border Style="{StaticResource InfoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="激活码"
                                           Style="{StaticResource InfoTitleStyle}"/>

                                <TextBlock x:Name="LicenseKeyTextBlock"
                                           Text="-"
                                           Style="{StaticResource InfoValueStyle}"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource InfoCardStyle}"
                                    Margin="0">

                                <StackPanel>
                                    <TextBlock Text="授权类型"
                                               Style="{StaticResource InfoTitleStyle}"/>

                                    <TextBlock x:Name="LicenseTypeTextBlock"
                                               Text="-"
                                               Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource InfoCardStyle}"
                                    Margin="0">

                                <StackPanel>
                                    <TextBlock Text="剩余时间"
                                               Style="{StaticResource InfoTitleStyle}"/>

                                    <TextBlock x:Name="RemainingTimeTextBlock"
                                               Text="-"
                                               Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                            </Border>

                        </Grid>

                        <Grid Margin="0,0,0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource InfoCardStyle}"
                                    Margin="0">

                                <StackPanel>
                                    <TextBlock Text="服务器时间"
                                               Style="{StaticResource InfoTitleStyle}"/>

                                    <TextBlock x:Name="ServerTimeTextBlock"
                                               Text="-"
                                               Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource InfoCardStyle}"
                                    Margin="0">

                                <StackPanel>
                                    <TextBlock Text="到期时间"
                                               Style="{StaticResource InfoTitleStyle}"/>

                                    <TextBlock x:Name="ExpireAtTextBlock"
                                               Text="-"
                                               Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                            </Border>

                        </Grid>

                        <Border Style="{StaticResource InfoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="本机设备编号"
                                           Style="{StaticResource InfoTitleStyle}"/>

                                <TextBlock x:Name="DeviceIdTextBlock"
                                           Text="-"
                                           FontSize="13"
                                           FontFamily="Consolas"
                                           Foreground="#374151"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InfoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="本地记录时间"
                                           Style="{StaticResource InfoTitleStyle}"/>

                                <TextBlock x:Name="ActivatedAtTextBlock"
                                           Text="-"
                                           Style="{StaticResource InfoValueStyle}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <!-- 底部按钮 -->
                <StackPanel Grid.Row="3"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center">

                    <Button x:Name="CloseButton"
                            Content="关闭"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>