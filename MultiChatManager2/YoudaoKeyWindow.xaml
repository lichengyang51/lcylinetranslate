<Window x:Class="MultiChatManager2.YoudaoKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="有道翻译 Key"
Width="560"
SizeToContent="Height"
WindowStartupLocation="CenterOwner"
ResizeMode="NoResize"
        Background="#F3F4F6"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>

        <Style x:Key="InputStyle"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Padding"
                    Value="10,0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="Foreground"
                    Value="#111827"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <Style x:Key="PasswordInputStyle"
               TargetType="PasswordBox">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Padding"
                    Value="10,0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="Foreground"
                    Value="#111827"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="MinWidth"
                    Value="105"/>
            <Setter Property="Padding"
                    Value="14,0"/>
            <Setter Property="Margin"
                    Value="5,0"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="Foreground"
                    Value="#111827"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F3F4F6"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background"
                    Value="#2563EB"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#2563EB"/>
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground"
                    Value="#B91C1C"/>
            <Setter Property="BorderBrush"
                    Value="#FCA5A5"/>
            <Setter Property="Background"
                    Value="#FEF2F2"/>
        </Style>

    </Window.Resources>

    <Grid Margin="22">

        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="16"
                Padding="26">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center">

                    <TextBlock Text="🔑"
                               FontSize="34"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="有道翻译配置"
                               Margin="0,8,0,0"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#111827"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="填写当前电脑使用的 AppKey 和 AppSecret"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- 状态 -->
                <Border Grid.Row="1"
                        x:Name="ConfigStatusBorder"
                        Margin="0,22,0,18"
                        Padding="12"
                        CornerRadius="10"
                        Background="#FFFBEB"
                        BorderBrush="#FDE68A"
                        BorderThickness="1">

                    <TextBlock x:Name="ConfigStatusTextBlock"
                               Text="⚠ 尚未配置"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#92400E"
                               HorizontalAlignment="Center"/>

                </Border>

                <!-- AppKey -->
                <StackPanel Grid.Row="2"
                            Margin="0,0,0,16">

                    <TextBlock Text="AppKey"
                               FontSize="13"
                               Foreground="#4B5563"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="AppKeyTextBox"
                             Style="{StaticResource InputStyle}"/>

                </StackPanel>

                <!-- AppSecret -->
                <StackPanel Grid.Row="3">

                    <TextBlock Text="AppSecret"
                               FontSize="13"
                               Foreground="#4B5563"
                               Margin="0,0,0,6"/>

                    <Grid>

                        <PasswordBox x:Name="AppSecretPasswordBox"
                                     Style="{StaticResource PasswordInputStyle}"
                                     PasswordChanged="AppSecretPasswordBox_PasswordChanged"/>

                        <TextBox x:Name="AppSecretTextBox"
                                 Style="{StaticResource InputStyle}"
                                 Visibility="Collapsed"
                                 TextChanged="AppSecretTextBox_TextChanged"/>

                    </Grid>

                    <CheckBox x:Name="ShowAppSecretCheckBox"
                              Content="显示 AppSecret"
                              Margin="0,10,0,0"
                              FontSize="12"
                              Foreground="#4B5563"
                              Cursor="Hand"
                              Checked="ShowAppSecretCheckBox_Changed"
                              Unchecked="ShowAppSecretCheckBox_Changed"/>

                </StackPanel>

                <!-- 提示 -->
                <TextBlock Grid.Row="4"
                           Text="配置只保存在当前电脑。没有填写 Key 时，软件不会调用有道翻译接口，也不会消耗字符。"
                           Margin="0,18,0,0"
                           FontSize="12"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"/>

                <!-- 底部按钮 -->
                <StackPanel Grid.Row="5"
                            Margin="0,18,0,4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button x:Name="TestButton"
                            Content="测试连接"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="TestButton_Click"/>

                    <Button x:Name="SaveButton"
                            Content="保存"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveButton_Click"/>

                    <Button x:Name="ClearButton"
                            Content="清空配置"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="ClearButton_Click"/>

                    <Button x:Name="CancelButton"
                            Content="取消"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="CancelButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>