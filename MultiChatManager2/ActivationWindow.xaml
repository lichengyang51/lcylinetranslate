<Window x:Class="MultiChatManager2.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件激活"
        Width="460"
        Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F5"
        ShowInTaskbar="True">

    <Window.Resources>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#1677FF"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#4096FF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#0958D9"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#A9C8F5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Border Margin="24"
                Padding="28"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="12">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="18"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="10"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="18"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="14"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="MultiChatManager"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#202020"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Row="2"
                           Text="请输入激活码"
                           FontSize="15"
                           Foreground="#444444"/>

                <TextBox x:Name="LicenseKeyTextBox"
                         Grid.Row="4"
                         Height="42"
                         Padding="12,8"
                         FontSize="15"
                         VerticalContentAlignment="Center"
                         BorderBrush="#CFCFCF"
                         BorderThickness="1"
                         Background="#FAFAFA"
                         MaxLength="200"/>

                <Button x:Name="ActivateButton"
                        Grid.Row="6"
                        Content="激活"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ActivateButton_Click"/>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="8"
                           Text=""
                           FontSize="13"
                           Foreground="#D9363E"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

                <StackPanel Grid.Row="10">

                    <TextBlock Text="当前设备编号"
                               FontSize="12"
                               Foreground="#888888"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="DeviceIdTextBlock"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="#666666"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>
</Window>