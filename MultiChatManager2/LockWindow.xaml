<Window x:Class="MultiChatManager2.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件已锁定"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False">

    <Grid Background="#E6000000">

        <Border Width="440"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="16">

            <StackPanel>

                <TextBlock Text="🔒"
                           FontSize="40"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="软件已锁定"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#202020"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="HintTextBlock"
                           Text="请输入解锁密码"
                           FontSize="13"
                           Foreground="#777777"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,22"/>

                <PasswordBox x:Name="UnlockPasswordBox"
                             Height="42"
                             Padding="12,8"
                             FontSize="15"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CFCFCF"
                             BorderThickness="1"
                             Margin="0,0,0,22"
                             KeyDown="UnlockPasswordBox_KeyDown"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button x:Name="ConfirmButton"
                            Width="120"
                            Height="36"
                            Margin="0,0,10,0"
                            Content="🔓 解锁"
                            Background="#1677FF"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ConfirmButton_Click"/>

                    <Button Width="120"
                            Height="36"
                            Content="🔑 忘记密码"
                            Background="White"
                            Foreground="#1677FF"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="ForgotPasswordButton_Click"/>

                </StackPanel>

                <Border x:Name="ForgotPasswordPanel"
                        Margin="0,24,0,0"
                        Padding="18"
                        Background="#F6F7F9"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="通过设备激活码重置密码"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#222222"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="请输入当前设备正在使用的完整激活码。"
                                   FontSize="12"
                                   Foreground="#777777"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <TextBox x:Name="ResetLicenseKeyTextBox"
                                 Height="38"
                                 Padding="10,7"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#CFCFCF"
                                 BorderThickness="1"
                                 Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button Width="100"
                                    Height="34"
                                    Margin="0,0,8,0"
                                    Content="验证并重置"
                                    Background="#1677FF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ResetPasswordByLicense_Click"/>

                            <Button Width="72"
                                    Height="34"
                                    Content="返回"
                                    Background="White"
                                    Foreground="#333333"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="CloseForgotPasswordPanel_Click"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Border>

    </Grid>
</Window>