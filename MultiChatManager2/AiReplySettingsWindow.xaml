<Window x:Class="MultiChatManager2.AiReplySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 智能回复设置"
        Width="520"
        Height="470"
        MinWidth="460"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource DialogTextBrush}">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1683E8"/>
            <Setter Property="BorderBrush" Value="#1683E8"/>
        </Style>
        <Style x:Key="DialogPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="AI 智能回复"
                       FontSize="23"
                       FontWeight="SemiBold"/>
            <TextBlock Text="使用你自己的 OpenAI API Key 生成回复"
                       Margin="0,5,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource DialogSecondaryTextBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Padding="12"
                Background="{DynamicResource DialogHintBrush}"
                BorderBrush="{DynamicResource DialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock Text="API Key 仅加密保存于当前 Windows 用户的电脑中，不会上传到 GitHub、Supabase 或软件服务器。生成回复时，仅发送你点击的那条对方消息、其译文和本次选择。"
                       TextWrapping="Wrap"
                       FontSize="12"
                       LineHeight="19"
                       Foreground="{DynamicResource DialogSecondaryTextBrush}"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="默认模型" FontSize="13" FontWeight="SemiBold"/>
            <ComboBox x:Name="ModelComboBox"
                      Grid.Row="1"
                      Margin="0,7,0,16"
                      Style="{StaticResource DialogComboBoxStyle}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="GPT-5.6 Luna（省钱、适合短回复）" Tag="gpt-5.6-luna"/>
                <ComboBoxItem Content="GPT-5.6 Terra（质量与成本均衡）" Tag="gpt-5.6-terra"/>
                <ComboBoxItem Content="GPT-5.6 Sol（最高质量、成本较高）" Tag="gpt-5.6-sol"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Text="OpenAI API Key" FontSize="13" FontWeight="SemiBold"/>
            <PasswordBox x:Name="ApiKeyPasswordBox"
                         Grid.Row="3"
                         Margin="0,7,0,0"
                         Style="{StaticResource DialogPasswordBoxStyle}"
                         ToolTip="留空会保留已保存的 Key"/>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="SavedKeyStatusTextBlock"
                       FontSize="12"
                       Foreground="{DynamicResource DialogSecondaryTextBrush}"/>
            <CheckBox x:Name="ClearSavedApiKeyCheckBox"
                      Margin="0,10,0,0"
                      Content="删除当前电脑已保存的 API Key"
                      Foreground="{DynamicResource DialogTextBrush}"
                      FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消"
                    Style="{StaticResource DialogButtonStyle}"
                    IsCancel="True"/>
            <Button Content="保存设置"
                    Style="{StaticResource PrimaryDialogButtonStyle}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
