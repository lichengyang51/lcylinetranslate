<Window x:Class="MultiChatManager2.AiReplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 智能回复"
        Width="580"
        Height="720"
        MinWidth="500"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource DialogTextBrush}"
        PreviewMouseDown="AiReplyWindow_PreviewMouseDown">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogSecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1683E8"/>
            <Setter Property="BorderBrush" Value="#1683E8"/>
        </Style>
        <Style x:Key="ResultTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="SpecificGoalCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DropDownFieldButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="AI 智能回复" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="根据这条对方消息和你的沟通选择，生成一条中文回复"
                       Margin="0,5,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource DialogSecondaryTextBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="10"
                Background="{DynamicResource DialogHintBrush}"
                BorderBrush="{DynamicResource DialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="对方消息" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="MessagePreviewTextBlock"
                           Margin="0,4,0,0"
                           MaxHeight="55"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource DialogSecondaryTextBrush}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="目标分类" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="GoalCategoryComboBox"
                      Style="{StaticResource DialogComboBoxStyle}"
                      SelectionChanged="GoalCategoryComboBox_SelectionChanged">
                <ComboBoxItem Content="日常互动类"/>
                <ComboBoxItem Content="关系推进类"/>
                <ComboBoxItem Content="话题控制类"/>
                <ComboBoxItem Content="情绪处理类"/>
                <ComboBoxItem Content="信息与判断类"/>
                <ComboBoxItem Content="行动推进类"/>
            </ComboBox>

            <DockPanel Margin="0,12,0,5">
                <TextBlock Text="具体目标（最多选择 2 项）"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0"/>
                <TextBlock x:Name="SpecificGoalSelectionHintTextBlock"
                           DockPanel.Dock="Right"
                           FontSize="12"
                           Foreground="{DynamicResource DialogSecondaryTextBrush}"
                           Text="请先选择目标分类"/>
            </DockPanel>
            <Grid>
                <Button x:Name="SpecificGoalsDropDownButton"
                        Style="{StaticResource DropDownFieldButtonStyle}"
                        IsEnabled="False"
                        Click="SpecificGoalsDropDownButton_Click">
                    <Grid>
                        <TextBlock x:Name="SpecificGoalsSelectionTextBlock"
                                   Margin="0,0,22,0"
                                   VerticalAlignment="Center"
                                   Text="请先选择目标分类"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Margin="8,0,0,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{DynamicResource DialogSecondaryTextBrush}"
                                   Text="▼"/>
                    </Grid>
                </Button>
                <Popup x:Name="SpecificGoalsPopup"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=SpecificGoalsDropDownButton}"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Width="{Binding ActualWidth, ElementName=SpecificGoalsDropDownButton}"
                            Margin="0,3,0,0"
                            Padding="10"
                            Background="{DynamicResource DialogControlBrush}"
                            BorderBrush="{DynamicResource DialogBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="具体目标" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock DockPanel.Dock="Right"
                                           FontSize="12"
                                           Foreground="{DynamicResource DialogSecondaryTextBrush}"
                                           Text="可选 1-2 项"/>
                            </DockPanel>
                            <ScrollViewer MaxHeight="156"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="SpecificGoalPanel"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="关系" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="RelationshipComboBox" Style="{StaticResource DialogComboBoxStyle}">
                    <ComboBoxItem Content="陌生关系"/>
                    <ComboBoxItem Content="普通朋友"/>
                    <ComboBoxItem Content="熟悉朋友"/>
                    <ComboBoxItem Content="信任关系"/>
                    <ComboBoxItem Content="知己关系"/>
                    <ComboBoxItem Content="暧昧关系"/>
                    <ComboBoxItem Content="恋人关系"/>
                    <ComboBoxItem Content="夫妻关系"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="回复风格" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="ReplyStyleComboBox" Style="{StaticResource DialogComboBoxStyle}">
                    <ComboBoxItem Content="真诚温和"/>
                    <ComboBoxItem Content="成熟稳重"/>
                    <ComboBoxItem Content="幽默轻松"/>
                    <ComboBoxItem Content="专业金融"/>
                    <ComboBoxItem Content="高情商"/>
                    <ComboBoxItem Content="共情倾听"/>
                    <ComboBoxItem Content="理性分析"/>
                    <ComboBoxItem Content="简洁直接"/>
                    <ComboBoxItem Content="温柔细腻"/>
                    <ComboBoxItem Content="鼓励支持"/>
                    <ComboBoxItem Content="自信从容"/>
                    <ComboBoxItem Content="神秘留白"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="4">
                <TextBlock Text="情绪表达" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="EmotionExpressionComboBox" Style="{StaticResource DialogComboBoxStyle}">
                    <ComboBoxItem Content="平淡（25%）"/>
                    <ComboBoxItem Content="自然（50%）"/>
                    <ComboBoxItem Content="热情（75%）"/>
                    <ComboBoxItem Content="舔狗（100%）"/>
                    <ComboBoxItem Content="究极舔狗（999%）"/>
                </ComboBox>
            </StackPanel>
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="回复范围" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="ReplyScopeComboBox" Style="{StaticResource DialogComboBoxStyle}">
                        <ComboBoxItem Content="默认（正常回复）"/>
                        <ComboBoxItem Content="挑选关键词（围绕某个关键词回复）"/>
                        <ComboBoxItem Content="回复所有话题（每个话题都逐一回复）"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="节奏" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="PaceComboBox" Style="{StaticResource DialogComboBoxStyle}">
                        <ComboBoxItem Content="简短回复（1-2句）"/>
                        <ComboBoxItem Content="自然聊天（3-5句）"/>
                        <ComboBoxItem Content="深入交流（适度展开）"/>
                        <ComboBoxItem Content="详细回复（完整表达）"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="0"
                       MinHeight="20"
                       Text="选择沟通方式后，点击生成回复。"
                       FontSize="12"
                       Foreground="{DynamicResource DialogSecondaryTextBrush}"/>
            <TextBox x:Name="GeneratedReplyTextBox"
                     Grid.Row="1"
                     Margin="0,7,0,0"
                     MinHeight="115"
                     Style="{StaticResource ResultTextBoxStyle}"
                     IsReadOnly="True"/>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CopyButton"
                    Content="复制回复"
                    Style="{StaticResource DialogButtonStyle}"
                    IsEnabled="False"
                    Click="CopyButton_Click"/>
            <Button x:Name="GenerateButton"
                    Content="生成回复"
                    Style="{StaticResource PrimaryDialogButtonStyle}"
                    Click="GenerateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
