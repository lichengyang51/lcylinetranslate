<Window x:Class="MultiChatManager2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LINE翻译多开业绩长虹版"
        Icon="Assets/app.ico"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource MainTextBrush}">

    <Window.Resources>

        <!-- 日间模式默认颜色 -->
        <SolidColorBrush x:Key="WindowBackgroundBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="BrowserBackgroundBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="SidebarBackgroundBrush"
                         Color="#EEEEEE"/>

        <SolidColorBrush x:Key="TopBarBackgroundBrush"
                         Color="#F7F7F7"/>

        <SolidColorBrush x:Key="MainTextBrush"
                         Color="#222222"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#777777"/>

        <SolidColorBrush x:Key="DividerBrush"
                         Color="#DDDDDD"/>

        <SolidColorBrush x:Key="ButtonBackgroundBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ButtonBorderBrush"
                         Color="#C8C8C8"/>

        <SolidColorBrush x:Key="ButtonHoverBrush"
                         Color="#E1E1E1"/>

        <SolidColorBrush x:Key="ButtonPressedBrush"
                         Color="#D2D2D2"/>

        <SolidColorBrush x:Key="ThemeButtonBackgroundBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ThemeButtonHoverBrush"
                         Color="#ECECEC"/>

        <!-- 设置弹窗中的下拉框使用自定义模板，避免深色模式时系统模板把白字画在浅色底上。 -->
        <Style x:Key="SettingsComboBoxItemStyle"
               TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background"
                    Value="{DynamicResource ThemeButtonBackgroundBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="Padding"
                    Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource ThemeButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBoxStyle"
               TargetType="{x:Type ComboBox}">
            <Setter Property="Background"
                    Value="{DynamicResource ThemeButtonBackgroundBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="8,2"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource SettingsComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ControlBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid>
                                    <ContentPresenter Margin="8,0,28,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      IsHitTestVisible="False"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <ToggleButton x:Name="DropDownToggle"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <Path Width="10"
                                                          Height="6"
                                                          Margin="0,1,10,0"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 5 5 L 10 0 Z"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        Margin="0,2,0,0"
                                        Background="{DynamicResource ThemeButtonBackgroundBrush}"
                                        BorderBrush="{DynamicResource ButtonBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <ScrollViewer MaxHeight="220"
                                                  CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ControlBorder"
                                        Property="Background"
                                        Value="{DynamicResource ThemeButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen"
                                     Value="True">
                                <Setter TargetName="ControlBorder"
                                        Property="Background"
                                        Value="{DynamicResource ButtonPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧账号项目样式 -->
        <Style x:Key="AccountItemButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="68"/>

            <Setter Property="Height"
                    Value="82"/>

            <Setter Property="Margin"
                    Value="1,5"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource MainTextBrush}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderBrush"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="RenderTransformOrigin"
                    Value="0.5,0.5"/>

            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1"
                                    ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="OuterBorder"
                                        Property="Background"
                                        Value="{DynamicResource ButtonHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="OuterBorder"
                                        Property="Background"
                                        Value="{DynamicResource ButtonPressedBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>
                <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="0.94"
                                             Duration="0:0:0.08"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="0.94"
                                             Duration="0:0:0.08"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1"
                                             Duration="0:0:0.14"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1"
                                             Duration="0:0:0.14"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>

        </Style>

        <!-- 添加按钮样式 -->
        <Style x:Key="AddButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="52"/>

            <Setter Property="Height"
                    Value="52"/>

            <Setter Property="Margin"
                    Value="9"/>

            <Setter Property="FontSize"
                    Value="28"/>

            <Setter Property="Background"
                    Value="{DynamicResource ButtonBackgroundBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource MainTextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource ButtonBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="AddBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="AddBorder"
                                        Property="Background"
                                        Value="{DynamicResource ThemeButtonHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="AddBorder"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- 日间/夜间切换按钮 -->
        <Style x:Key="ThemeToggleButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="28"/>

            <Setter Property="MinWidth"
                    Value="96"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0,6,12,6"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource MainTextBrush}"/>

            <Setter Property="Background"
                    Value="{DynamicResource ThemeButtonBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource ButtonBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ThemeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ThemeBorder"
                                        Property="Background"
                                        Value="{DynamicResource ThemeButtonHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ThemeBorder"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>
        <!-- 顶部功能按钮统一样式 -->
        <Style x:Key="TopToolbarButtonStyle"
       TargetType="Button">

            <Setter Property="Height"
            Value="28"/>

            <Setter Property="Padding"
            Value="12,0"/>

            <Setter Property="Margin"
            Value="0,0,6,0"/>

            <Setter Property="FontSize"
            Value="12"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="Foreground"
            Value="{DynamicResource MainTextBrush}"/>

            <Setter Property="Background"
            Value="{DynamicResource ThemeButtonBackgroundBrush}"/>

            <Setter Property="BorderBrush"
            Value="{DynamicResource ButtonBorderBrush}"/>

            <Setter Property="BorderThickness"
            Value="1"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ToolbarBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="ToolbarBorder"
                                Property="Background"
                                Value="{DynamicResource ThemeButtonHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="ToolbarBorder"
                                Property="Opacity"
                                Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>
    </Window.Resources>

    <AdornerDecorator x:Name="RootAdornerDecorator">

    <Grid x:Name="RootLayout"
          Background="{DynamicResource WindowBackgroundBrush}">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="78"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- 左侧账号区域 -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">

            <DockPanel LastChildFill="True">

                <!-- 左下角添加按钮 -->
                <Button x:Name="btnAdd"
                        DockPanel.Dock="Bottom"
                        Content="+"
                        Style="{StaticResource AddButtonStyle}"
                        ToolTip="添加账号"
                        Click="BtnAdd_Click"/>

                <!-- 账号滚动区域 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="AccountPanel"
                                HorizontalAlignment="Center"
                                Margin="0,5,0,5"/>

                </ScrollViewer>

            </DockPanel>

        </Border>

        <!-- 右侧主区域 -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>

                <RowDefinition Height="40"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- 顶部功能工具栏 -->
            <Border Grid.Row="0"
        Background="{DynamicResource TopBarBackgroundBrush}"
        BorderBrush="{DynamicResource DividerBrush}"
        BorderThickness="0,0,0,1">

                <Grid Margin="0,0,10,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>
                    <CheckBox
                        Grid.Column="0"
                        x:Name="TranslateVisibleChatOnlyCheckBox"
          Content="关闭自动翻译"
          IsChecked="True"
          Click="TranslateVisibleChatOnlyCheckBox_Click"
          VerticalAlignment="Center"
          Margin="0,0,12,0"
          FontSize="12"
          FontWeight="SemiBold"
          Foreground="{DynamicResource MainTextBrush}"
          Cursor="Hand"
          ToolTip="勾选后，只翻译当前打开并实际显示的聊天内容；后台消息和未滚动到的历史消息不会消耗字符"/>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">

                        <Button x:Name="TranslationQuotaButton"
        MinWidth="108"
        Content="📊 字符情况"
        Style="{StaticResource TopToolbarButtonStyle}"
        ToolTip="查看有道翻译资源包剩余字符"
        Click="TranslationQuotaButton_Click"/>
                        <Button x:Name="UpdateButton"
            MinWidth="76"
            Content="↻ 更新"
            Style="{StaticResource TopToolbarButtonStyle}"
            ToolTip="检查并更新到最新版本"
            Click="UpdateButton_Click"/>

                        <Button x:Name="RestartButton"
            MinWidth="76"
            Content="⟳ 重启"
            Style="{StaticResource TopToolbarButtonStyle}"
            ToolTip="重新启动软件"
            Click="RestartButton_Click"/>

                        <Button x:Name="LockButton"
            MinWidth="92"
            Content="🔒 锁定软件"
            Style="{StaticResource TopToolbarButtonStyle}"
            ToolTip="锁定当前软件"
            Click="LockButton_Click"/>

                        <Button x:Name="SettingsButton"
            MinWidth="76"
            Margin="0"
            Content="⚙ 设置"
            Style="{StaticResource TopToolbarButtonStyle}"
            ToolTip="打开软件设置"
            Click="SettingsButton_Click"/>
                        <Popup x:Name="SettingsPopup"
       PlacementTarget="{Binding ElementName=SettingsButton}"
       Placement="Bottom"
       HorizontalOffset="-205"
       VerticalOffset="4"
       StaysOpen="False"
       AllowsTransparency="True">

                            <Border Width="280"
            Padding="8"
            Background="{DynamicResource ThemeButtonBackgroundBrush}"
            BorderBrush="{DynamicResource ButtonBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12"
                              ShadowDepth="3"
                              Opacity="0.25"/>
                                </Border.Effect>

                                <StackPanel>

                                    <TextBlock Text="外观与授权"
                                               Margin="8,4,8,5"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <Button x:Name="LicenseStatusButton"
                    Height="34"
                    HorizontalContentAlignment="Left"
                    Padding="12,0"
                    Content="🔑 激活状态"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource MainTextBrush}"
                    Cursor="Hand"
                    ToolTip="查看当前授权状态"
                    Click="LicenseStatusButton_Click"/>

                                    <Button x:Name="ThemeToggleButton"
                    Height="34"
                    HorizontalContentAlignment="Left"
                    Padding="12,0"
                    Content="🌙 夜间模式"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource MainTextBrush}"
                    Cursor="Hand"
                    ToolTip="切换日间模式和夜间模式"
                    Click="ThemeToggle_Click"/>

                                    <Separator Margin="6,6"
                                               Background="{DynamicResource DividerBrush}"/>

                                    <TextBlock Text="翻译"
                                               Margin="8,2,8,5"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <StackPanel Margin="8,0,8,8">
                                        <TextBlock Text="译文字体大小"
                                                   Margin="0,0,0,4"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MainTextBrush}"/>
                                        <ComboBox x:Name="TranslationFontSizeComboBox"
                                                  Height="28"
                                                  Style="{StaticResource SettingsComboBoxStyle}"
                                                  SelectedValuePath="Tag"
                                                  ToolTip="LINE 和 WhatsApp 共用">
                                            <ComboBoxItem Content="12 px（默认）" Tag="12"/>
                                            <ComboBoxItem Content="14 px" Tag="14"/>
                                            <ComboBoxItem Content="16 px" Tag="16"/>
                                            <ComboBoxItem Content="18 px" Tag="18"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Margin="8,0,8,8">
                                        <TextBlock Text="译文显示方式"
                                                   Margin="0,0,0,4"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MainTextBrush}"/>
                                        <ComboBox x:Name="TranslationDisplayModeComboBox"
                                                  Height="28"
                                                  Style="{StaticResource SettingsComboBoxStyle}"
                                                  SelectedValuePath="Tag"
                                                  ToolTip="LINE 和 WhatsApp 共用">
                                            <ComboBoxItem Content="原文下方" Tag="BelowOriginal"/>
                                            <ComboBoxItem Content="仅显示译文" Tag="TranslationOnly"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <Button x:Name="SetYoudaoKeyButton"
                    Height="34"
                    HorizontalContentAlignment="Left"
                    Padding="12,0"
                    Content="🔑 有道翻译 Key"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource MainTextBrush}"
                    Cursor="Hand"
                    Click="SetYoudaoKeyButton_Click"/>

                                    <Button x:Name="ClearTranslationCacheButton"
                    Height="34"
                    HorizontalContentAlignment="Left"
                    Padding="12,0"
                    Content="🧹 清除本次翻译缓存"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource MainTextBrush}"
                    Cursor="Hand"
                    ToolTip="不会清除有道 Key、LINE 登录或已显示的译文"
                    Click="ClearTranslationCacheButton_Click"/>

                                    <Separator Margin="6,6"
                                               Background="{DynamicResource DividerBrush}"/>

                                    <TextBlock Text="安全"
                                               Margin="8,2,8,5"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <Button x:Name="SetLockPasswordButton"
                    Height="34"
                    HorizontalContentAlignment="Left"
                    Padding="12,0"
                    Content="🔐 设置锁定密码"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource MainTextBrush}"
                    Cursor="Hand"
                    Click="SetLockPasswordButton_Click"/>

                                </StackPanel>

                            </Border>

                        </Popup>
                    </StackPanel>

                </Grid>

            </Border>

            <!-- 浏览器区域 -->
            <Grid Grid.Row="1"
                  x:Name="BrowserContainer"
                  Background="{DynamicResource BrowserBackgroundBrush}">

                <TextBlock x:Name="EmptyMessage"
                           Text=""
                           FontSize="24"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

            </Grid>

        </Grid>
    </Grid>

    </AdornerDecorator>

</Window>
